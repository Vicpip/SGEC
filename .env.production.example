# SGEC — plantilla de variables para producción (Docker Compose).
# Copia este archivo a `.env` en la raíz del repositorio DENTRO del servidor y rellénalo ahí.
# El `.env` real nunca se sube al repositorio (está en .gitignore).

# ── Base de datos ───────────────────────────────────────────────────────
DB_USER=sgec
# Contraseña larga y aleatoria, por ejemplo: openssl rand -base64 24
DB_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
# Con menos de 32 caracteres el servidor no arranca en producción.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── Dominio ─────────────────────────────────────────────────────────────
# CLIENT_URL: origen permitido por CORS y base de los enlaces de los correos.
CLIENT_URL=https://<tu-dominio>
# VITE_API_URL se hornea en el frontend al construir la imagen: cambiarlo exige `--build`.
VITE_API_URL=https://<tu-dominio>/api

# ── Acceso ──────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=escom.ipn.mx,alumno.ipn.mx,ipn.mx
# Proxies inversos delante de Node. 1 = el Nginx del host.
TRUST_PROXY=1

# ── Archivos ────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20

# ── Correo saliente (opcional) ──────────────────────────────────────────
# Sin SMTP_HOST el sistema no envía correos y funciona igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_DRY_RUN=false
