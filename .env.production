# ── SGEC — Variables de entorno producción ───────────────────────────────
# Renombra este archivo a .env en la raíz del proyecto en el VPS
# NUNCA subas este archivo a GitHub

# Base de datos
DB_HOST=db
DB_PORT=3306
DB_NAME=sgec
DB_USER=sgec_user
DB_PASSWORD=CambiaEstaContrasena2026!

# JWT — genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_con_secreto_seguro_de_64_bytes
JWT_EXPIRES_IN=8h

# Dominios institucionales permitidos
ALLOWED_EMAIL_DOMAINS=ipn.mx,alumno.ipn.mx

# URL pública del backend (usada por el frontend en el build)
VITE_API_URL=https://sgec-escom.duckdns.org/api
